{
  "name": "joy-vscode",
  "displayName": "Joy",
  "description": "Joy project management inside VS Code: backlog tree, item editor, session indicator. Shells out to the joy CLI.",
  "version": "0.2.2",
  "publisher": "joyint",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=20.19"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joyint/joy-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/joyint/joy-vscode/issues"
  },
  "icon": "resources/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [],
  "joyCli": {
    "minimumVersion": "0.18.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "joy",
          "title": "Joy",
          "icon": "resources/joy.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "joyItem",
          "title": "Joy Item",
          "icon": "resources/joy.svg"
        }
      ]
    },
    "views": {
      "joy": [
        {
          "id": "joyBacklog",
          "name": "Backlog",
          "contextualTitle": "Joy"
        }
      ],
      "joyItem": [
        {
          "id": "joyItemDetail",
          "name": "Item",
          "type": "webview",
          "contextualTitle": "Joy Item"
        }
      ]
    },
    "commands": [
      {
        "command": "joy.addItem",
        "title": "New Item...",
        "category": "Joy",
        "icon": "$(add)"
      },
      {
        "command": "joy.addMilestone",
        "title": "New Milestone...",
        "category": "Joy",
        "icon": "$(milestone)"
      },
      {
        "command": "joy.openBoard",
        "title": "Open Board",
        "category": "Joy",
        "icon": "$(layout)"
      },
      {
        "command": "joy.refresh",
        "title": "Refresh Backlog",
        "category": "Joy",
        "icon": "$(refresh)"
      },
      {
        "command": "joy.sortOldest",
        "title": "Sort: Oldest First",
        "category": "Joy",
        "icon": "$(arrow-up)"
      },
      {
        "command": "joy.sortNewest",
        "title": "Sort: Newest First",
        "category": "Joy",
        "icon": "$(arrow-down)"
      },
      {
        "command": "joy.clearParent",
        "title": "Remove Parent",
        "category": "Joy",
        "icon": "$(remove)"
      },
      {
        "command": "joy.openDetail",
        "title": "Open Item Detail",
        "category": "Joy"
      },
      {
        "command": "joy.show",
        "title": "Show Details (Markdown)",
        "category": "Joy"
      },
      {
        "command": "joy.start",
        "title": "Start",
        "category": "Joy"
      },
      {
        "command": "joy.submit",
        "title": "Submit for Review",
        "category": "Joy"
      },
      {
        "command": "joy.close",
        "title": "Close",
        "category": "Joy"
      },
      {
        "command": "joy.reopen",
        "title": "Reopen",
        "category": "Joy"
      },
      {
        "command": "joy.openInstallDocs",
        "title": "Open Install Docs",
        "category": "Joy"
      },
      {
        "command": "joy.configureExecutablePath",
        "title": "Configure CLI Path...",
        "category": "Joy"
      },
      {
        "command": "joy.authenticate",
        "title": "Authenticate...",
        "category": "Joy"
      },
      {
        "command": "joy.initCopilot",
        "title": "Init Copilot",
        "category": "Joy"
      }
    ],
    "viewsWelcome": [
      {
        "view": "joyBacklog",
        "contents": "The joy CLI was not found.\n[Install joy](https://github.com/joyint/joy)\n[Set executable path](command:workbench.action.openSettings?%22joy.executablePath%22)",
        "when": "joy:cliMissing"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "joy.addItem",
          "when": "view == joyBacklog",
          "group": "navigation@1"
        },
        {
          "command": "joy.addMilestone",
          "when": "view == joyBacklog",
          "group": "navigation@2"
        },
        {
          "command": "joy.openBoard",
          "when": "view == joyBacklog",
          "group": "navigation@3"
        },
        {
          "command": "joy.sortOldest",
          "when": "view == joyBacklog && joy:backlogOrder != old",
          "group": "navigation@4"
        },
        {
          "command": "joy.sortNewest",
          "when": "view == joyBacklog && joy:backlogOrder == old",
          "group": "navigation@4"
        },
        {
          "command": "joy.refresh",
          "when": "view == joyBacklog",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "joy.show",
          "when": "view == joyBacklog && viewItem =~ /(^| )status:/",
          "group": "1_open@1"
        },
        {
          "command": "joy.clearParent",
          "when": "view == joyBacklog && viewItem =~ /(^| )has-parent( |$)/",
          "group": "2_structure@1"
        }
      ]
    },
    "configuration": {
      "title": "Joy",
      "properties": {
        "joy.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the joy executable. Leave empty to auto-resolve via PATH, login shell, and common install locations.\n\nUse [Joy: Configure CLI Path...](command:joy.configureExecutablePath) for a guided dialog showing the auto-detected path as a placeholder."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.mjs --production",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "tsc -p tsconfig.test.json && mocha --recursive out-test/test/unit",
    "test:integration": "tsc -p tsconfig.test.json && vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "package": "vsce package --no-dependencies --out package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.16.10",
    "@types/vscode": "^1.92.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "mocha": "^11.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
