{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "mocha", "vscode"],
    "outDir": "out-test",
    "rootDir": "src",
    "sourceMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
